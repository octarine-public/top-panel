{
	"compilerOptions": {
		"target": "esnext",
		"module": "ES2022",
		"moduleResolution": "Node",
		"baseUrl": ".",
		"paths": {
		    "github.com/octarine-public/wrapper/index": [
		        "../wrapper/index"
		    ]
		},
		"noEmit": true,
		"outDir": "scripts/",
		"noUnusedLocals": true,
		"strict": true,
		"alwaysStrict": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"lib": [
			"ESNext"
		],
	},
	"include": [
	    "./**/*.ts",
	    "./**/*.d.ts",
	    "../wrapper/*.d.ts",
	    "../wrapper/wrapper/**/*.d.ts"
	],
	"exclude": [
		"node_modules/**/*",
		"scripts_files/**/*",
	],
	"compileOnSave": true
}
